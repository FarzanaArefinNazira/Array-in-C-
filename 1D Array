//Write a C program to print Array by taking user input 
#include<stdio.h>
int main(){
    int arr[300]; 
    int i,n;
    printf("Enter the value of array index:");
    scanf("%d",&n);
    for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
     for(i=0;i<n;i++){
        printf("%d",arr[i]);
    }
}
